{% extends 'dashboard-base.html.twig' %}

{% block title %}Activités{% endblock %}

{% block body %}
<div class="card mb-5 mb-lg-10">
    <!--begin::Card header-->
    <div class="card-header">
        <!--begin::Heading-->
        <div class="card-title">
            <h3>Dernières actions sur les étudiants</h3>
        </div>
        <!--end::Heading-->
        <!--begin::Toolbar-->
        <div class="card-toolbar">
            {% if hasMore %}
                <a
                    href="{{ path('log_index', { before: lastTimestamp|date('c') }) }}"
                    class="btn btn-sm btn-primary my-1"
                >
                    Précédemment
                </a>
            {% else %}
                <a
                    href="{{ path('log_index') }}"
                    class="btn btn-sm btn-secondary my-1"
                >
                    Les plus récents
                </a>
            {% endif %}

        </div>
        <!--end::Toolbar-->
    </div>
    <!--end::Card header-->
    <!--begin::Card body-->
    <div class="card-body p-0">
        <!--begin::Table wrapper-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table table-flush align-middle table-row-bordered table-row-solid gy-4 gs-9">
                <!--begin::Thead-->
                <thead class="border-gray-200 fs-5 fw-bold bg-lighten">
                    <tr>
                        <th class="min-w-50px">ID</th>
                        <th class="min-w-250px">Etudiant</th>
                        <th class="min-w-100px">Action</th>
                        <th class="min-w-150px">Changements</th>
                        <th class="min-w-150px">Date</th>
                    </tr>
                </thead>
                <!--end::Thead-->
                <!--begin::Tbody-->
                <tbody class="fw-6 fw-bold text-gray-600">
                {% for log in logs %}
                    <tr>
                        <td>{{ log.studentId }}</td>
                        <td class="min-w-200px">
                            <span class="text-gray-800">
                                {# {{ log.studentName ?? 'Étudiant #' ~ log.studentId }} #}
                                {{ log.studentName }}
                            </span>
                        </td>

                        <td class="min-w-150px">
                            {% if log.action == 'CREATE' %}
                                <span class="badge badge-light-success">Création</span>
                            {% elseif log.action == 'UPDATE' %}
                                <span class="badge badge-light-warning">Modification</span>
                            {% elseif log.action == 'DELETE' %}
                                <span class="badge badge-light-danger">Suppression</span>
                            {% elseif log.action == 'IMPORTED' %}
                                <span class="badge badge-light-info">Import CSV</span>
                            {% else %}
                                <span class="badge badge-light-info">{{ log.action }}</span>
                            {% endif %}
                        </td>

                        <td class="min-w-250px text-gray-500">
                            {% if log.changes %}
                                <ul class="mb-0 ps-4">
                                    {% for field, change in log.changes %}
                                        <li>
                                            <strong>{{ field }}</strong> :
                                            {{ change.old ?? '—' }} → {{ change.new ?? '—' }}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <em>Aucun détail</em>
                            {% endif %}
                        </td>

                        <td class="min-w-150px">
                            {{ log.timestamp|date('d/m/Y H:i') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-10">
                            Aucune activité récente
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <!--end::Tbody-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table wrapper-->
    </div>
    <!--end::Card body-->
</div>
{% endblock %}
