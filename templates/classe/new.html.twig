{% extends 'dashboard-base.html.twig' %}

{% block title %}Ajouter{% endblock %}

{% block body %}
    <h1>
        {% if is_from_classe is defined and is_from_classe == true %}
            {{ classe.name }}: Détails du nouvel étudiant
        {% else %}
            Renseignement de la classe
        {% endif %}
    </h1>

    {% for notice in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ notice }}</div>
    {% endfor %}
    {% for notice in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ notice }}</div>
    {% endfor %}

    {{ include('classe/_form.html.twig') }}

{% endblock %}
