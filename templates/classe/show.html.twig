{% extends 'dashboard-base.html.twig' %}

{% block title %}Fiche de la {{ classe.name }} {% endblock %}

{% block body %}

    {% for notice in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ notice }}</div>
    {% endfor %}
    {% for notice in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ notice }}</div>
    {% endfor %}

    <h1>Renseignements sur la classe</h1>

    <div class="card-p pt-5 bg-body flex-grow-1 mb-4">
        <!--begin::Row-->
        <div class="row g-0">
            <!--begin::Col-->
            <div class="col mr-8">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Nom de la classe</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="d-flex align-items-center">
                    <div class="fs-4 fw-bolder">{{ classe.name }}</div>
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
            <!--begin::Col-->
            <div class="col">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Nb étudiants</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="fs-4 fw-bolder">{{ classe.students|length }}</div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
        <!--begin::Row-->
        <div class="row g-0 mt-8">
            {# <!--begin::Col-->
            <div class="col mr-8">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">ID</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="fs-4 fw-bolder">{{ classe.id }}</div>
                <!--end::Stat-->
            </div>
            <!--end::Col--> #}
            <!--begin::Col-->
            <div class="col">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Centre</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="d-flex align-items-center">
                    <div class="fs-4 fw-bolder">{% if classe.location %}{{ classe.location.name }}{% else %}--inconnu--{% endif %}</div>
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>

    <div class="d-flex justify-content-between mb-4">
        <a href="{{ path('classe_index') }}" class="btn btn-secondary w-66">Voir toutes les classes</a>
        <div class="d-flex justify-content-end">
            <a href="{{ path('classe_edit', {'id': classe.id}) }}" class="btn btn-primary w-66 me-2">Editer</a>
            {{ include('classe/_delete_form.html.twig') }}
        </div>
    </div>

	<!--begin::Card-->
	<div class="card">
    {{ include('student/_student_list_tools.html.twig') }}
    {{ include('student/modal_import_student.html.twig') }}
    {{ include('student/_student_list_table_body.html.twig', {'is_from_classe': true}) }}
    </div>
    <!--end::Card-->
{% endblock %}

{% block foot_script %}
	{{parent()}}
	<script type="text/javascript">
		$("#kt_subscriptions_table").DataTable();
	</script>
{% endblock %}
