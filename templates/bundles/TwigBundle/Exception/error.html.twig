{% extends 'base.html.twig' %}

{% block title %}Erreur!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>
    Bonjour {% if app.user %}{{ app.user.name }}.{% endif %}
    </h1>
    <h2>La page que vous cherchez n'existe pas (encore) sur l'application.</h2>
    <p>Veuillez vérifier l'URL ou cliquer sur les liens suivants selon votre destination:</p>
    
    <ul>
        <li>Liste <code><a href="{{ path('student_list') }}">des étudiants</a></code></li>
        <li>Liste <code><a href="{{ path('classe_index') }}">des classes</a></code></li>
        <li>Liste <code><a href="{{ path('subject_index') }}">des matières</a></code></li>
    </ul>
</div>
{% endblock %}
