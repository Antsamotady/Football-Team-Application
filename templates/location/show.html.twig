{% extends 'dashboard-base.html.twig' %}

{% block title %}Centre{% endblock %}

{% block body %}
    <h1>Détails du centre {{ location.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ location.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ location.name }}</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>{{ location.address }}</td>
            </tr>
            <tr>
                <th>Directeur</th>
                <td>{{ location.director }}</td>
            </tr>
            <tr>
                <th>Mise à jour le</th>
                <td>{{ location.updatedAt ? location.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between">
        <a href="{{ path('location_index') }}" class="btn btn-secondary w-66">Voir toutes les centres</a>
        <div class="d-flex justify-content-end">
            <a href="{{ path('location_edit', {'id': location.id}) }}" class="btn btn-primary w-66 me-2">Editer</a>
            {{ include('location/_delete_form.html.twig') }}
        </div>
    </div>

    <hr>

    <h2>Les classes de ce centre</h2>

	<!--begin::Card-->
	<div class="card">
        {{ include('classe/_classe_list_table_body.html.twig', {'is_from_location': true}) }}
    </div>
    <!--end::Card-->
{% endblock %}

{% block foot_script %}
	{{parent()}}
	<script type="text/javascript">
		$("#kt_subscriptions_table").DataTable();
	</script>
{% endblock %}
