    <div class="d-flex justify-content-between mb-4">
        <a href="{{ path('location_index') }}" class="btn btn-secondary w-66">Voir toutes les centres</a>
        <div class="d-flex justify-content-end">
            <a href="{{ path('location_edit', {'id': location.id}) }}" class="btn btn-primary w-66 me-2">Editer</a>
            {{ include('location/_delete_form.html.twig') }}
