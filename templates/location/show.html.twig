                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
        <!--begin::Row-->
        <div class="row g-0 mt-8">
            {# <!--begin::Col-->
            <div class="col mr-8">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">ID</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="fs-4 fw-bolder">{{ location.id }}</div>
                <!--end::Stat-->
            </div>
            <!--end::Col--> #}
            <!--begin::Col-->
            <div class="col">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Addresse</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="d-flex align-items-center">
                    <div class="fs-4 fw-bolder">{{ location.address }}</div>
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
