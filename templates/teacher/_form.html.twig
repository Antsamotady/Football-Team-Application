<!--begin::Basic info-->
<div class="card mb-5 mb-xl-10">
    <!--begin::Card header-->
    <div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#kt_account_profile_details" aria-expanded="true" aria-controls="kt_account_profile_details">
        <!--begin::Card title-->
        <div class="card-title m-0">
            {% if is_edit is defined and is_edit == true %}
                <h3 class="fw-bolder m-0">Modifier l'enseignant</h3>
            {% else %}
                <h3 class="fw-bolder m-0">Nouvel enseignant</h3>
            {% endif %}
        </div>
        <!--end::Card title-->
    </div>
    <!--begin::Card header-->
    <!--begin::Content-->
    <div id="kt_account_settings_profile_details" class="collapse show">
        <!--begin::Form-->
        {{ form_start(form) }}
            <!--begin::Card body-->
            <div class="card-body border-top p-9">
                <!--begin::Input group-->
                <div class="row mb-6">
                    <!--begin::Label-->
                    <label class="col-lg-4 col-form-label required fw-bold fs-6">Prénom</label>
                    <!--end::Label-->
                    <!--begin::Col-->
                    <div class="col-lg-8 fv-row fv-plugins-icon-container">
                        {{ form_widget(form.firstname, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                    <div class="fv-plugins-message-container invalid-feedback"></div></div>
                    <!--end::Col-->
                </div>
                <div class="row mb-6">
                    <!--begin::Label-->
                    <label class="col-lg-4 col-form-label required fw-bold fs-6">Nom</label>
                    <!--end::Label-->
                    <!--begin::Col-->
                    <div class="col-lg-8 fv-row fv-plugins-icon-container">
                        {{ form_widget(form.lastname, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                    <div class="fv-plugins-message-container invalid-feedback"></div></div>
                    <!--end::Col-->
                </div>
                <div class="row mb-6">
                    <!--begin::Label-->
                    <label class="col-lg-4 col-form-label required fw-bold fs-6">Sexe</label>
                    <!--end::Label-->
                    <!--begin::Col-->
                    <div class="col-lg-8 fv-row fv-plugins-icon-container">
                        {{ form_widget(form.gender, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                    <div class="fv-plugins-message-container invalid-feedback"></div></div>
                    <!--end::Col-->
                </div>
                <div class="row mb-6">
                    <!--begin::Label-->
                    <label class="col-lg-4 col-form-label fw-bold fs-6">Classes</label>
                    <!--end::Label-->
                    <!--begin::Col-->
                    <div class="col-lg-8 fv-row fv-plugins-icon-container">
                        {{ form_widget(form.classes, {'attr': {
                            'class': 'form-select form-select-lg form-select-solid',
                            'data-control': 'select2',
                            'data-placeholder': 'Sélectionnez les classes',
                            'data-allow-clear': 'true'
                        }})}}
                        <div class="fv-plugins-message-container invalid-feedback"></div>
                    </div>
                    <!--end::Col-->
                </div>
                <div class="row mb-6">
                    <!--begin::Label-->
                    <label class="col-lg-4 col-form-label fw-bold fs-6">Matière(s)</label>
                    <!--end::Label-->
                    <!--begin::Col-->
                    <div class="col-lg-8 fv-row fv-plugins-icon-container">
                        {{ form_widget(form.subjects, {'attr': {
                            'class': 'form-select form-select-lg form-select-solid',
                            'data-control': 'select2',
                            'data-placeholder': 'Sélectionnez les matières',
                            'data-allow-clear': 'true'
                        }})}}
                        <div class="fv-plugins-message-container invalid-feedback"></div>
                    </div>
                    <!--end::Col-->
                </div>
                <!--end::Input group-->
            </div>
            <!--end::Card body-->
            <!--begin::Actions-->
            <div class="card-footer d-flex justify-content-end py-6 px-9">
                <a href="{{ path('teacher_index') }}" class="btn btn-light btn-active-light-primary me-2">Annuler</a>
                <button type="submit" class="btn btn-primary" id="kt_account_profile_details_submit">Enregistrer</button>
            </div>
            <!--end::Actions-->
        {{ form_end(form) }}
        <!--end::Form-->
    </div>
    <!--end::Content-->
</div>
<!--end::Basic info-->

