{% extends 'dashboard-base.html.twig' %}

{% block title %}Enseignant{% endblock %}

{% block body %}
    <h1>Détails sur l'enseignant</h1>


    <div class="card-p pt-5 bg-body flex-grow-1 mb-4">
        <!--begin::Row-->
        <div class="row g-0">
            <!--begin::Col-->
            <div class="col mr-8">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Nom</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="d-flex align-items-center">
                    <div class="fs-4 fw-bolder">{{ teacher.firstname }} {{ teacher.lastname }}</div>
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
            <!--begin::Col-->
            <div class="col">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Matière(s) enseignée(s)</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="fs-4 fw-bolder">
                    {% for subject in teacher.subjects %}
                        {{ subject.name }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        --aucune--
                    {% endfor %}
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
        <!--begin::Row-->
        <div class="row g-0 mt-8">
            {# <!--begin::Col-->
            <div class="col mr-8">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">ID</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="fs-4 fw-bolder">{{ location.id }}</div>
                <!--end::Stat-->
            </div>
            <!--end::Col--> #}
            <!--begin::Col-->
            <div class="col">
                <!--begin::Label-->
                <div class="fs-7 text-muted fw-bold">Classes</div>
                <!--end::Label-->
                <!--begin::Stat-->
                <div class="d-flex align-items-center">
                    <div class="fs-4 fw-bolder">
                        {% for classe in teacher.classes %}
                            {{ classe.name }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            --aucune--
                        {% endfor %}
                    </div>
                </div>
                <!--end::Stat-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{ path('teacher_index') }}" class="btn btn-secondary w-66">Voir toutes les enseignants</a>
        <div class="d-flex justify-content-end">
            <a href="{{ path('teacher_edit', {'id': teacher.id}) }}" class="btn btn-primary w-66 me-2">Editer</a>
            {{ include('teacher/_delete_form.html.twig') }}
        </div>
    </div>

{% endblock %}
