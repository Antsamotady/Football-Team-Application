                    <div class="fs-xl-2x fs-2 fw-boldest">
                        <a href="{{ path('student_list') }}" class="text-gray-800 text-hover-primary">{{ nb_students }}</a>
                    </div>
                    <!--end::Total Amount-->
                    <div class="border-bottom w-100 my-7 my-lg-16"></div>
                    <!--begin::Invoice To-->
                    <div class="text-gray-600 fs-6 fw-bold mb-3">DESTINATAIRE</div>
