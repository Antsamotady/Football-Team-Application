{% extends 'dashboard-base.html.twig' %}

{% block title %}Configuration{% endblock %}

{% block body %}

{% for notice in app.flashes('success') %}
    <div class="alert alert-success" role="alert">{{ notice }}</div>
{% endfor %}
{% for notice in app.flashes('error') %}
    <div class="alert alert-danger" role="alert">{{ notice }}</div>
{% endfor %}

<div class="card mb-5 mb-xl-10">
    <!--begin::Card header-->
    <div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse" data-bs-target="#kt_account_signin_method">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">Parametrage général</h3>
        </div>
    </div>
    <!--end::Card header-->
    <!--begin::Content-->
    <div id="kt_account_settings_signin_method" class="collapse show">
        <!--begin::Card body-->
        <div class="card-body border-top p-9">
            <!--begin::Email Address-->
            <div class="d-flex flex-wrap align-items-center">
                <!--begin::Edit-->
                <div id="kt_signin_email_edit" class="flex-row-fluid">
                    {{ form_start(form) }}
                    <!--begin::Form-->
                        <div class="row mb-6">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <div class="fv-row mb-0 fv-plugins-icon-container">
                                    <label class="form-label fs-6 fw-bolder mb-3">Nom de votre établissement</label>
                                    {{ form_widget(form.InstitutionName, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                                <div class="fv-plugins-message-container invalid-feedback"></div></div>
                            </div>
                            <div class="col-lg-6">
                                <div class="fv-row mb-0 fv-plugins-icon-container">
                                    <label for="confirmemailpassword" class="form-label fs-6 fw-bolder mb-3">Année Scolaire</label>
                                    {{ form_widget(form.AcademicYear, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                                <div class="fv-plugins-message-container invalid-feedback"></div></div>
                            </div>
                        </div>
                        <div class="row mb-6">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <div class="fv-row mb-0 fv-plugins-icon-container">
                                    <label class="form-label fs-6 fw-bolder mb-3">Note de délibération</label>
                                    {{ form_widget(form.passingScore, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                                <div class="fv-plugins-message-container invalid-feedback"></div></div>
                            </div>
                            <div class="col-lg-6">
                                <div class="fv-row mb-0 fv-plugins-icon-container">
                                    <label for="confirmemailpassword" class="form-label fs-6 fw-bolder mb-3">Date de délibération</label>
                                    {{ form_widget(form.deliberationDate, {'attr': {'class': 'form-control form-control-lg form-control-solid'}})}}
                                <div class="fv-plugins-message-container invalid-feedback"></div></div>
                            </div>
                        </div>
                        <div class="d-flex">
                            <button type="submit" class="btn btn-primary me-2 px-6">Enregistrer</button>
                        </div>
                    <!--end::Form-->
                    {{ form_end(form) }}
                </div>
                <!--end::Edit-->
            </div>
            <!--end::Email Address-->
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Content-->
</div>

{% endblock %}
