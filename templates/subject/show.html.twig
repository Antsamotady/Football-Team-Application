{% extends 'dashboard-base.html.twig' %}

{% block title %}Matière{% endblock %}

{% block body %}
    <h1>Détaille de la matière</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ subject.id }}</td>
            </tr>
            <tr>
                <th>Nome</th>
                <td>{{ subject.name }}</td>
            </tr>
            <tr>
                <th>Coefficient</th>
                <td>{{ subject.coefficient }}</td>
            </tr>
            <tr>
                <th>Enseignant</th>
                <td>{{ subject.teacher }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between">
        <a href="{{ path('subject_index') }}" class="btn btn-secondary w-66">Voir toutes les matières</a>
        <div class="d-flex justify-content-end">
            <a href="{{ path('subject_edit', {'id': subject.id}) }}" class="btn btn-primary w-66 me-2">Editer</a>
            {{ include('subject/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
