{% set isFromStudent = is_from_student|default(false) %}

<div class="menu menu-sub menu-sub-dropdown w-400px w-md-400px" data-kt-menu="true" data-popper-placement="bottom-end">
  <!--begin::Header-->
  <div class="px-7 py-5">
    <div class="fs-5 text-dark fw-bolder">Options de filtrage</div>
  </div>
  <!--end::Header-->
  <!--begin::Separator-->
  <div class="separator border-gray-200"></div>
  <!--end::Separator-->
  {{ form_start(filter_form) }}
  <!--begin::Content-->
  <div class="px-7 py-5" data-kt-subscription-table-filter="form">
    <!--begin::Input group-->
    <div class="row mb-3">
        <!--begin::Col-->
        <div class="col-lg-6 fv-row">
          {{ form_widget(filter_form.firstname, {'attr': {'class': 'form-control fw-bolder'}}) }}
        </div>
        <!--end::Col-->
        <!--begin::Col-->
        <div class="col-lg-6 fv-row">
          {{ form_widget(filter_form.lastname, {'attr': {'class': 'form-control fw-bolder'}}) }}
        </div>
        <!--end::Col-->
    </div>
    <div class="mb-3">
      {{ form_widget(filter_form.gender, {'attr': {'class': 'form-control fw-bolder'}}) }}
    </div>
    
    {% if isFromStudent %}
      <div class="mb-3">
        {{ form_widget(filter_form.classe, {'attr': {'class': 'form-control fw-bolder'}}) }}
      </div>
      <div class="mb-3">
        {{ form_widget(filter_form.location, {'attr': {'class': 'form-control fw-bolder'}}) }}
      </div>
    {% endif %}

    <h5 class="fs-5 text-dark fw-bolder py-3">Filtres de notes</h5>
    <div id="score-filters">
        {% for scoreFilter in filter_form.scoreFilters %}
            <div class="mb-3 border rounded p-3 score-filter-item">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        {{ form_widget(scoreFilter.subject, {'attr': {'class': 'form-select fw-bolder'}}) }}
                    </div>
                    <div class="col-md-3 mb-2">
                        {{ form_widget(scoreFilter.min, {'attr': {'class': 'form-control fw-bolder', 'placeholder': 'Min'}}) }}
                    </div>
                    <div class="col-md-3 mb-2">
                        {{ form_widget(scoreFilter.max, {'attr': {'class': 'form-control fw-bolder', 'placeholder': 'Max'}}) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <!--end::Input group-->

    <!--begin::Actions-->
    <div class="d-flex justify-content-end">
      <a type="button" class="btn btn-light btn-active-light-primary fw-bold me-2 px-6" href="{{ isFromStudent ? path('student_list') : path('classe_show', {'id': classe.id}) }}">Réinitialiser</a>
      <button type="submit" class="btn btn-primary fw-bold px-6" data-kt-menu-dismiss="true" data-kt-subscription-table-filter="filter">Filtrer</button>
    </div>
    <!--end::Actions-->
  </div>
  <!--end::Content-->
  {{ form_end(filter_form) }}
</div>