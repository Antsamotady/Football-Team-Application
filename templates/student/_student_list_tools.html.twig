{% set isFromStudent = is_from_student|default(false) %}

<div class="card-header border-0 pt-6">
	{% if isFromStudent %}
		<!--begin::Card title-->
		<div class="card-title">
			<!--begin::Search-->
			<div class="d-flex align-items-center position-relative my-1">
			
				{{ include('student/_search_name_form.html.twig') }}

			</div>
			<!--end::Search-->
			<div style="margin-left: 10px;"><span class="text-muted mt-1 fw-bold fs-7">{{ result }} résultats</span></div>
		</div>
		<!--begin::Card title-->
	{% else %}
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bolder fs-3 mb-1">Les étudiants de cette classe</span>
			{% if not isFromStudent %}
				<span class="text-muted mt-1 fw-bold fs-7">
					{{ has_filters|default(false) ? students|length ~ ' trouvés sur ' ~ classe.students|length : '' }}
				</span>
			{% endif %}
        </h3>
	{% endif %}

	<!--begin::Card toolbar-->
	<div class="card-toolbar">
		<!--begin::Toolbar-->
		<div class="d-flex justify-content-end" data-kt-subscription-table-toolbar="base">
			<!--begin::Filter-->
			<button type="button" class="btn {{ has_filters|default(false) ? 'btn-light-primary' : 'btn-light btn-active-light-primary' }} me-3" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
				<!--begin::Svg Icon | path: icons/duotune/general/gen031.svg-->
				<span class="svg-icon svg-icon-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
						<path d="M19.0759 3H4.72777C3.95892 3 3.47768 3.83148 3.86067 4.49814L8.56967 12.6949C9.17923 13.7559 9.5 14.9582 9.5 16.1819V19.5072C9.5 20.2189 10.2223 20.7028 10.8805 20.432L13.8805 19.1977C14.2553 19.0435 14.5 18.6783 14.5 18.273V13.8372C14.5 12.8089 14.8171 11.8056 15.408 10.964L19.8943 4.57465C20.3596 3.912 19.8856 3 19.0759 3Z" fill="black" />
					</svg>
				</span>
				<!--end::Svg Icon-->
				{{ has_filters|default(false) ? 'Filtrée' : 'Filtrer' }}
			</button>

			<a type="button" class="btn btn-light btn-active-light-primary fw-bold me-2 px-6" href="{{ isFromStudent ? path('student_list') : path('classe_show', {'id': classe.id}) }}">Tous</a>

			<!--begin::Menu 1-->
			{{ include('student/_student_filter_form.html.twig') }}
			<!--end::Menu 1-->

			<!--end::Filter-->
			<!--begin::Export-->
			<a type="button" class="btn btn-light btn-active-light-primary me-3" href="{{ isFromStudent ? path('student_export') : path('classe_student_export', {'id': classe.id}) }}">
				<!--begin::Svg Icon | path: icons/duotune/arrows/arr078.svg-->
				<span class="svg-icon svg-icon-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
						<rect opacity="0.3" x="12.75" y="4.25" width="12" height="2" rx="1" transform="rotate(90 12.75 4.25)" fill="black" />
						<path d="M12.0573 6.11875L13.5203 7.87435C13.9121 8.34457 14.6232 8.37683 15.056 7.94401C15.4457 7.5543 15.4641 6.92836 15.0979 6.51643L12.4974 3.59084C12.0996 3.14332 11.4004 3.14332 11.0026 3.59084L8.40206 6.51643C8.0359 6.92836 8.0543 7.5543 8.44401 7.94401C8.87683 8.37683 9.58785 8.34458 9.9797 7.87435L11.4427 6.11875C11.6026 5.92684 11.8974 5.92684 12.0573 6.11875Z" fill="black" />
						<path d="M18.75 8.25H17.75C17.1977 8.25 16.75 8.69772 16.75 9.25C16.75 9.80228 17.1977 10.25 17.75 10.25C18.3023 10.25 18.75 10.6977 18.75 11.25V18.25C18.75 18.8023 18.3023 19.25 17.75 19.25H5.75C5.19772 19.25 4.75 18.8023 4.75 18.25V11.25C4.75 10.6977 5.19771 10.25 5.75 10.25C6.30229 10.25 6.75 9.80228 6.75 9.25C6.75 8.69772 6.30229 8.25 5.75 8.25H4.75C3.64543 8.25 2.75 9.14543 2.75 10.25V19.25C2.75 20.3546 3.64543 21.25 4.75 21.25H18.75C19.8546 21.25 20.75 20.3546 20.75 19.25V10.25C20.75 9.14543 19.8546 8.25 18.75 8.25Z" fill="#C4C4C4" />
					</svg>
				</span>
				<!--end::Svg Icon-->Export CSV
			</a>
			<!--end::Export-->
			<!--begin::Add subscription-->
			<a type="button" class="btn btn-light btn-active-light-primary me-3" href="#" data-bs-toggle="modal" data-bs-target="#kt_modal_new_student">
				<!--begin::Svg Icon | path: icons/duotune/arrows/arr078.svg-->
				<span class="svg-icon svg-icon-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
						<rect opacity="0.3" x="12.75" y="4.25" width="12" height="2" rx="1" transform="rotate(90 12.75 4.25)" fill="black" />
						<path d="M12.0573 6.11875L13.5203 7.87435C13.9121 8.34457 14.6232 8.37683 15.056 7.94401C15.4457 7.5543 15.4641 6.92836 15.0979 6.51643L12.4974 3.59084C12.0996 3.14332 11.4004 3.14332 11.0026 3.59084L8.40206 6.51643C8.0359 6.92836 8.0543 7.5543 8.44401 7.94401C8.87683 8.37683 9.58785 8.34458 9.9797 7.87435L11.4427 6.11875C11.6026 5.92684 11.8974 5.92684 12.0573 6.11875Z" fill="black" />
						<path d="M18.75 8.25H17.75C17.1977 8.25 16.75 8.69772 16.75 9.25C16.75 9.80228 17.1977 10.25 17.75 10.25C18.3023 10.25 18.75 10.6977 18.75 11.25V18.25C18.75 18.8023 18.3023 19.25 17.75 19.25H5.75C5.19772 19.25 4.75 18.8023 4.75 18.25V11.25C4.75 10.6977 5.19771 10.25 5.75 10.25C6.30229 10.25 6.75 9.80228 6.75 9.25C6.75 8.69772 6.30229 8.25 5.75 8.25H4.75C3.64543 8.25 2.75 9.14543 2.75 10.25V19.25C2.75 20.3546 3.64543 21.25 4.75 21.25H18.75C19.8546 21.25 20.75 20.3546 20.75 19.25V10.25C20.75 9.14543 19.8546 8.25 18.75 8.25Z" fill="#C4C4C4" />
					</svg>
				</span>
				<!--end::Svg Icon-->Import CSV
			</a>

			{% if isFromStudent %}
				<a href="{{ path('student_new') }}" class="btn btn-primary">
					<!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
					<span class="svg-icon svg-icon-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
							<rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black" />
							<rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black" />
						</svg>
					</span>
				<!--end::Svg Icon-->Ajouter un étudiant
				</a>
			{% else %}
				<a href="{{ path('student_new_from_classe', { id: classe.id }) }}" class="btn btn-light btn-active-primary"  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-trigger="hover" title="" data-bs-original-title="Un étudiant pour cette classe">
					<span class="svg-icon svg-icon-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
							<rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black"></rect>
							<rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black"></rect>
						</svg>
					</span>
					Ajouter un étudiant
				</a>
			{% endif %}
			<!--end::Add subscription-->
		</div>
		<!--end::Toolbar-->
		<!--begin::Group actions-->
		<div class="d-flex justify-content-end align-items-center d-none" data-kt-subscription-table-toolbar="selected">
			<div class="fw-bolder me-5">
			<span class="me-2" data-kt-subscription-table-select="selected_count"></span>Selected</div>
			<button type="button" class="btn btn-danger" data-kt-subscription-table-select="delete_selected">Delete Selected</button>
		</div>
		<!--end::Group actions-->
	</div>
	<!--end::Card toolbar-->
</div>